{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "AI Continue",
  "description": "__MSG_appDesc__",
  "version": "1.3.2",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "stop-auto-continue": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_stopCommand__"
    }
  },
  "minimum_chrome_version": "102",
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
